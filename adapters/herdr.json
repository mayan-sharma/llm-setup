{
  "name": "herdr",
  "displayName": "Herdr app",
  "detect": { "env": ["HERDR_APP_HOME"], "paths": ["~/.config/herdr-app"], "bin": ["herdr-app"] },
  "home": { "env": "HERDR_APP_HOME", "default": "~/.config/herdr-app" },
  "payload": "herdr",
  "extraFiles": [
    "layouts/cogitator.json",
    "layouts/cogitator.svg",
    "themes/cogitator.json",
    "mods/cogitator",
    "mods/cogitator-feeds"
  ],
  "mcp": "none",
  "restartNote": "Herdr reloads live; pick the layout with ctrl-shift-l (layout.switch)."
}
